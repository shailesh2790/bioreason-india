# PetriDish Firebase configuration
# Copy these into .env.local for local dev, and into Vercel env vars for production.

# ── Frontend (Web SDK) — public, safe to expose ─────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Backend (FastAPI) — service account JSON, KEEP SECRET ───────────────────
# Paste the entire downloaded JSON as a single-line string into Railway's
# fastapi service env (railway variables --service fastapi --set "FIREBASE_SERVICE_ACCOUNT_JSON=...").
# Never commit this value.
FIREBASE_SERVICE_ACCOUNT_JSON=
