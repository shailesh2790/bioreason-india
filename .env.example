# ── LLM Provider ─────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=sk-ant-...

# ── Neo4j ─────────────────────────────────────────────────
# Local:   bolt://127.0.0.1:7687
# Railway: bolt://neo4j.railway.internal:7687
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bioreason123

# ── Next.js → FastAPI proxy ───────────────────────────────
# Local:   http://localhost:8000
# ngrok:   https://xxxx.ngrok-free.app
# Railway: https://your-fastapi.railway.app
FASTAPI_URL=http://localhost:8000
